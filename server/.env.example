# ============================================================
# HealSync HMS API — server configuration
# Copy to .env and fill in your values. All variables optional.
# ============================================================

# Port the API listens on
PORT=8080

# MongoDB connection string. REPLACE with your MongoDB URI
# (local mongod or Atlas: mongodb+srv://user:pass@cluster/...)
MONGO_URI=mongodb://127.0.0.1:27017/healsync

# Comma-separated list of allowed frontend origins (credentials cookies need exact match)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Secret for signing JWT access tokens — set a long random string in production
JWT_SECRET=dev-only-secret-change-me

# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# true = OTP emails are printed to the server console instead of sent
EMAIL_CONSOLE_ONLY=true

# SMTP settings for real OTP emails (only needed when EMAIL_CONSOLE_ONLY=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HealSync HMS <no-reply@healsync.health>
