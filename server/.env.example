# ============================================================
# HealSync HMS API — server configuration
# Copy to .env and fill in your values. All variables optional.
# ============================================================

# Port the API listens on
PORT=8080

# MongoDB connection string. REPLACE with your MongoDB URI
# (local mongod or Atlas: mongodb+srv://user:pass@cluster/...)
MONGO_URI=mongodb://127.0.0.1:27017/healsync

# Comma-separated list of allowed frontend origins (credentials cookies need exact match)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Secret for signing JWT access tokens — set a long random string in production
JWT_SECRET=dev-only-secret-change-me

# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Email delivery transport. Default 'smtp' — ALL emails (OTP, appointment
# notifications) go through a real SMTP server. 'log' is a test-only escape
# hatch that prints/captures messages instead of sending; never use it in
# production (production refuses to start without SMTP).
EMAIL_TRANSPORT=smtp

# SMTP settings for authentic email delivery. Required in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Medicore HMS <no-reply@medicore.health>

# eSewa online payments (Nepal). Public bookings pay the doctor's consultation
# fee through eSewa before the appointment is created; with these blank the
# payment endpoint refuses to start (503).
# Sandbox (test) credentials: product code EPAYTEST, secret 8gBm/:&EnhH.1/q,
# test login eSewa ID 9711111111 / password Nepal@123 / token 123456.
# Live credentials from merchant.esewa.com.np.
ESEWA_ENV=test
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=

# Public frontend origin (where the browser lands after payment) and API
# origin (where eSewa POSTs the signed callback). Identical in production.
APP_BASE_URL=http://localhost:5173
APP_API_URL=http://localhost:8080
