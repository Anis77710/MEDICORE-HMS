# ============================================================
# Medicore HMS — Frontend environment
# ------------------------------------------------------------
# Copy to .env and adjust.
# ============================================================

# true (or unset) = demo mode on the built-in mock API
# false = call a real backend
VITE_USE_MOCK_API=false

# Base URL of a real backend API (no trailing slash) — only used when
# VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:8080/api
